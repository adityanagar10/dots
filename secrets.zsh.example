# Copy this file to ~/.config/secrets.zsh and fill in real values.
# ~/.zshrc sources ~/.config/secrets.zsh automatically if it exists.
#
#   cp secrets.zsh.example ~/.config/secrets.zsh
#   chmod 600 ~/.config/secrets.zsh
#
# Never commit the real file — it's gitignored here on purpose.

export GRAFANA_OPS_TOKEN="your-ops-grafana-service-account-token"
export GRAFANA_PROD_TOKEN="your-prod-grafana-service-account-token"
